{
  "js/ts.tsdk.path": "node_modules/typescript/lib",
  "vsicons.associations.files": [
    {
      "icon": "rollup",
      "filenamesGlob": [
        "rollup.demos",
      ],
      "extensionsGlob": [ "js" ],
      "filename": true,
      "format": "svg",
    }
  ],
  "conventionalCommits.scopes": [
    "advapi32",
    "kernel32",
    "user32",
    "shell32",
    "secur32",
    "ole32",
    "psapi",
    "libs",
    "ctypes",
    "structs",
    "consts",
    "internals",
    "rollup",
    "demos",
    "build",
  ],
  "cSpell.dictionaries": [
    "win32"
  ],
  "cSpell.words": [
    "advapi",
    "demoname",
    "dllname",
    "koffi",
    "Koffi",
    "libwin",
    "ntstatus",
    "psapi",
    "mucho",
    "secur"
  ],
  "debug.javascript.terminalOptions": {
    "skipFiles": [
      "<node_internals>/**",
      "**/node_modules/**"
    ]
  },
  "explorer.autoRevealExclude": {
    "**/lib": true
  }
}
